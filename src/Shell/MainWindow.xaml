<Window x:Class="IWar3Key.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:IWar3Key.Shell.Controls"
        xmlns:core="clr-namespace:IWar3Key.Shell.Core"
        Title="iWar3Key"
        Width="680" Height="720" MinWidth="680" MinHeight="720"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource AppBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Foreground="{StaticResource TextBrush}"
        Language="zh-CN"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="41"
                        ResizeBorderThickness="0"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{StaticResource AppBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="41" />
        <RowDefinition Height="50" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="12,0,7,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="5" Background="White"
                    BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1">
              <controls:Icon Kind="logo" Width="13" Height="13" Stroke="{StaticResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="iWar3Key" Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}"
                       FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最小化">
              <controls:Icon Kind="minimize" Width="10" Height="10" />
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}" IsEnabled="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最大化（已禁用）">
              <controls:Icon Kind="maximize" Width="10" Height="10" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButtonStyle}" Click="CloseButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭">
              <controls:Icon Kind="close" Width="10" Height="10" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Game bar -->
      <Border Grid.Row="1" Background="{StaticResource AppBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="15,0,13,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="5" Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1">
              <controls:Icon Kind="monitor" Width="14" Height="14" Stroke="{StaticResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Warcraft III" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="VersionPill" Style="{StaticResource PillStyle}" Margin="7,0,0,0">
                  <TextBlock x:Name="VersionPillText" Text="未检测" FontFamily="{StaticResource MonoFont}"
                             FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Ellipse x:Name="StateDot" Width="5" Height="5" Fill="{StaticResource Muted2Brush}" VerticalAlignment="Center" />
                <TextBlock x:Name="RunStateText" Text="未运行" FontSize="9" Foreground="{StaticResource MutedBrush}"
                           Margin="4,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="PauseIndicator" Text="已暂停" FontSize="9" Foreground="{StaticResource RedBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ContentControl x:Name="SchemeSelectorHost" Margin="0,0,5,0" VerticalAlignment="Center" />
            <Button x:Name="AttachButton" Style="{StaticResource PrimaryButtonStyle}" Click="AttachButton_Click"
                    Margin="0,0,5,0" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="plug" Width="12" Height="12" Stroke="White" />
                <TextBlock x:Name="AttachButtonText" Text="应用增强" Margin="5,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="LaunchButton" Style="{StaticResource BaseButtonStyle}" Click="LaunchButton_Click">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="play" Width="12" Height="12" Stroke="{StaticResource TextBrush}" />
                <TextBlock Text="启动游戏" Margin="5,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Shell -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
              <TextBlock Text="配 置" FontSize="9" Foreground="{StaticResource Muted2Brush}" Margin="16,0,0,6" />
              <RadioButton x:Name="NavGame" Style="{StaticResource NavRadioStyle}" GroupName="Nav"
                           Tag="game" IsChecked="True" Checked="Nav_Checked" AutomationProperties.Name="游戏设置">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="monitor" Width="14" Height="14" VerticalAlignment="Center"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="游戏设置" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavItems" Style="{StaticResource NavRadioStyle}" GroupName="Nav"
                           Tag="items" Checked="Nav_Checked" AutomationProperties.Name="物品改键">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="key" Width="14" Height="14" VerticalAlignment="Center"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="物品改键" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavSkills" Style="{StaticResource NavRadioStyle}" GroupName="Nav"
                           Tag="skills" Checked="Nav_Checked" AutomationProperties.Name="技能改键">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="keyboard" Width="14" Height="14" VerticalAlignment="Center"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="技能改键" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavMapping" Style="{StaticResource NavRadioStyle}" GroupName="Nav"
                           Tag="mapping" Checked="Nav_Checked" AutomationProperties.Name="按键映射">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="arrow" Width="14" Height="14" VerticalAlignment="Center"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="按键映射" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavChat" Style="{StaticResource NavRadioStyle}" GroupName="Nav"
                           Tag="chat" Checked="Nav_Checked" AutomationProperties.Name="快捷喊话">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="chat" Width="14" Height="14" VerticalAlignment="Center"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="快捷喊话" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadioStyle}" GroupName="Nav"
                           Tag="settings" Checked="Nav_Checked" AutomationProperties.Name="设置">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Kind="settings" Width="14" Height="14" VerticalAlignment="Center"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="设置" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>

          </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Padding="0">
          <Grid x:Name="PageHost" Margin="16,14,16,16" />
        </ScrollViewer>
      </Grid>

      <!-- Toast -->
      <Border x:Name="ToastBorder" Grid.RowSpan="3" Panel.ZIndex="20"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
              Background="{StaticResource AccentDarkBrush}" CornerRadius="6" Padding="14,9" Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>
        <TextBlock x:Name="ToastText" Text="" Foreground="White" FontSize="11" TextWrapping="Wrap" MaxWidth="420" />
      </Border>
    </Grid>
  </Border>
</Window>
