<UserControl x:Class="IWar3Key.Shell.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IWar3Key.Shell.Controls">
  <StackPanel Margin="0,0,0,4">
    <Grid Margin="0,0,0,12">
      <TextBlock Text="快捷喊话" Style="{StaticResource PageTitleStyle}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="AddMacroButton" Style="{StaticResource PrimaryButtonStyle}"
                Click="AddMacro_Click" ToolTip="最多 9 个（Alt+1 ~ Alt+9）">
          <StackPanel Orientation="Horizontal">
            <controls:Icon Kind="plus" Width="11" Height="11" Stroke="White" />
            <TextBlock Text="添加宏" Margin="5,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <Grid Margin="0,0,30,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="74" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="38" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="触发键" Style="{StaticResource TinyMutedStyle}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="频道" Style="{StaticResource TinyMutedStyle}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="内容" Style="{StaticResource TinyMutedStyle}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="启用" Style="{StaticResource TinyMutedStyle}" HorizontalAlignment="Center" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Chat.Macros}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="74" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <controls:KeyCaptureButton Grid.Column="0" Style="{StaticResource KeycapStyle}"
                                           HorizontalContentAlignment="Center"
                                           Chord="{Binding Binding, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Style="{StaticResource ComboStyle}" Height="27" Margin="4,0,0,0"
                          SelectedValuePath="Tag" SelectedValue="{Binding Channel, Mode=TwoWay}">
                  <ComboBoxItem Content="所有人" Tag="all" />
                  <ComboBoxItem Content="盟友" Tag="ally" />
                </ComboBox>
                <TextBox Grid.Column="2" Style="{StaticResource InputStyle}" Height="27" Margin="6,0,0,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleButton Grid.Column="3" Style="{StaticResource SwitchStyle}" IsChecked="{Binding Enabled}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="4" Style="{StaticResource DangerIconButtonStyle}" Click="DeleteMacro_Click"
                        Tag="{Binding}" ToolTip="删除宏">
                  <controls:Icon Kind="trash" Width="12" Height="12" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
          <controls:Icon Kind="settings" Width="14" Height="14" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="发送设置" Style="{StaticResource CardTitleStyle}" Margin="7,0,0,0" />
        </StackPanel>

        <Grid Margin="0,0,0,7">
          <TextBlock Text="发送间隔" Style="{StaticResource LabelStyle}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBox Style="{StaticResource InputStyle}" Width="62"
                     Text="{Binding Chat.SendDelayMs, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="ms" Style="{StaticResource MutedStyle}" Margin="6,0,0,0" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,7">
          <TextBlock Text="冷却时间" Style="{StaticResource LabelStyle}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBox Style="{StaticResource InputStyle}" Width="62"
                     Text="{Binding Chat.CooldownMs, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="ms" Style="{StaticResource MutedStyle}" Margin="6,0,0,0" />
          </StackPanel>
        </Grid>

        <Grid>
          <TextBlock Text="防连发" Style="{StaticResource LabelStyle}" />
          <ToggleButton Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                        IsChecked="{Binding Chat.AntiSpam}" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
