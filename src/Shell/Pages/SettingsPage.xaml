<UserControl x:Class="IWar3Key.Shell.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IWar3Key.Shell.Controls"
             xmlns:core="clr-namespace:IWar3Key.Shell.Core">
  <StackPanel Margin="0,0,0,4">
    <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,12" />

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <controls:Icon Kind="folder" Width="14" Height="14" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="游戏与启动" Style="{StaticResource CardTitleStyle}" Margin="7,0,0,0" />
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource InputStyle}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                   Text="{Binding Game.Path, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1" Content="浏览" Style="{StaticResource SmallButtonStyle}" Margin="7,0,0,0"
                  Click="BrowseGame_Click" />
        </Grid>

        <Grid Margin="0,9,0,0">
          <TextBlock Text="检测到游戏后自动应用" Style="{StaticResource LabelStyle}" />
          <ToggleButton Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" IsChecked="{Binding Game.AutoApply}" />
        </Grid>

        <Grid Margin="0,9,0,0">
          <TextBlock Text="应用增强快捷键" Style="{StaticResource LabelStyle}" />
          <controls:KeyCaptureButton Style="{StaticResource KeycapStyle}" Width="132"
                                     HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                     Chord="{Binding Game.ApplyHotkey, Mode=TwoWay}" />
        </Grid>

        <Grid Margin="0,9,0,0">
          <TextBlock Text="关闭时最小化到托盘" Style="{StaticResource LabelStyle}" />
          <ToggleButton Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                        IsChecked="{Binding Game.MinimizeToTray}"
                        ToolTip="开启后点击关闭会隐藏到托盘；关闭则直接退出" />
        </Grid>

        <Grid Margin="0,9,0,0">
          <TextBlock Text="紧急暂停" Style="{StaticResource LabelStyle}"
                     ToolTip="只暂停物品/技能/映射改键与快捷喊话；窗口、视距、状态条保持当前状态" />
          <controls:KeyCaptureButton Style="{StaticResource KeycapStyle}" Width="132"
                                     HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                     Chord="{Binding Game.PanicHotkey, Mode=TwoWay}"
                                     ToolTip="只暂停物品/技能/映射改键与快捷喊话；窗口、视距、状态条保持当前状态" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <controls:Icon Kind="folder" Width="14" Height="14" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="数据" Style="{StaticResource CardTitleStyle}" Margin="7,0,0,0" />
        </StackPanel>

        <Grid Margin="0,0,0,8">
          <TextBlock Text="配置目录" Style="{StaticResource LabelStyle}" />
          <Button Content="打开" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Right" Click="OpenDataDir_Click" />
        </Grid>

        <Grid Margin="0,0,0,8">
          <TextBlock Text="导出 / 导入" Style="{StaticResource LabelStyle}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="导出" Style="{StaticResource SmallButtonStyle}" Click="Export_Click" />
            <Button Content="导入" Style="{StaticResource SmallButtonStyle}" Margin="6,0,0,0" Click="Import_Click" />
          </StackPanel>
        </Grid>

        <Grid>
          <TextBlock Text="分辨率注册表备份" Style="{StaticResource LabelStyle}" />
          <Button Content="恢复" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Right" Click="RestoreRegistry_Click" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <controls:Icon Kind="info" Width="14" Height="14" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="关于" Style="{StaticResource CardTitleStyle}" Margin="7,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource AccentSoftBrush}"
                  BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1">
            <controls:Icon Kind="logo" Width="18" Height="18" Stroke="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{x:Static core:AppInfo.NameVersionText}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static core:AppInfo.SupportedVersions}" Style="{StaticResource TinyMutedStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
