<UserControl x:Class="IWar3Key.Shell.Pages.ItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IWar3Key.Shell.Controls">
  <StackPanel Margin="0,0,0,4">
    <Grid Margin="0,0,0,12">
      <TextBlock Text="物品改键" Style="{StaticResource PageTitleStyle}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="快捷全开" Style="{StaticResource GhostButtonStyle}" Click="QuickAll_Click" Tag="on" />
        <Button Content="快捷全关" Style="{StaticResource GhostButtonStyle}" Click="QuickAll_Click" Tag="off" />
        <TextBlock Text="启用" Style="{StaticResource MutedStyle}" Margin="12,0,6,0" />
        <ToggleButton Style="{StaticResource SwitchStyle}" IsChecked="{Binding Input.ItemsEnabled}" />
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <controls:Icon Kind="key" Width="14" Height="14" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="物品键" Style="{StaticResource CardTitleStyle}" Margin="7,0,0,0" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Input.Items}" IsEnabled="{Binding Input.ItemsEnabled}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource PanelSoftBrush}" BorderBrush="{StaticResource LineSoftBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,7,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NativeLabel}" Style="{StaticResource TinyMutedStyle}" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0" ToolTip="快捷施法">
                      <controls:Icon Kind="bolt" Width="11" Height="11" Stroke="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <ToggleButton Style="{StaticResource SwitchStyle}" IsChecked="{Binding QuickCast}" Margin="4,0,0,0" />
                    </StackPanel>
                    <controls:KeyCaptureButton Style="{StaticResource KeycapStyle}" Width="60"
                                               Placeholder="录入"
                                               Chord="{Binding Key, Mode=TwoWay}" />
                    <Button Style="{StaticResource DangerIconButtonStyle}" Width="20" Height="20" Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding Key, Converter={StaticResource NotEmptyToBool}}"
                            Click="ClearItem_Click" Tag="{Binding}"
                            ToolTip="清除" AutomationProperties.Name="清除物品键">
                      <controls:Icon Kind="close" Width="9" Height="9"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
